# ─────────────────────────────────────────────────────────────
# Platita.pe — variables de entorno
# Copia este archivo a .env.local y complétalo. En Vercel se
# configuran en Project Settings → Environment Variables.
# Todo es opcional: si un bloque falta, esa función se desactiva
# y el resto del formulario sigue funcionando.
# ─────────────────────────────────────────────────────────────

# --- Sitio -------------------------------------------------------
# URL canónica sin barra final. Sólo hace falta si NO es https://platita.pe
NEXT_PUBLIC_SITE_URL=https://platita.pe

# --- Analítica (GA4) -------------------------------------------
# ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX).
# Sin esto no se carga analítica ni se muestra el banner de cookies.
# El rastreo solo se activa tras el consentimiento del visitante.
NEXT_PUBLIC_GA_ID=

# --- Supabase (fuente de verdad de los leads) -----------------
# Dashboard → Project Settings → API
# Docs: https://supabase.com/docs/guides/api/api-keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=          # clave "publishable" (sb_publishable_...)
SUPABASE_SECRET_KEY=                           # clave "secret" (sb_secret_...) — SÓLO servidor
# Compatibilidad con el esquema viejo de claves (deprecado a fin de 2026):
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=
#   SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (CAPTCHA) ----------------------------
# Dashboard → Turnstile → tu widget → Settings (site key y secret key)
# Docs: https://developers.cloudflare.com/turnstile/get-started/server-side-validation/
# El widget usa data-action "registro" / "captador"; el servidor lo verifica.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hostnames que siteverify puede devolver (el widget cubre varios dominios).
# Si se deja vacío, no se valida el hostname (con aviso en logs).
TURNSTILE_ALLOWED_HOSTNAMES=platita.pe,www.platita.pe,localhost,127.0.0.1
# Claves de PRUEBA (siempre pasan) mientras no tengas las reales:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# En producción, si faltan las claves de Turnstile los envíos se RECHAZAN
# (fail-closed). Pon TURNSTILE_OPTIONAL=true solo si quieres lanzar sin CAPTCHA.
# TURNSTILE_OPTIONAL=false

# --- Resend (emails: confirmación al lead + aviso al equipo) --
# Docs: https://resend.com/docs/send-with-nextjs
RESEND_API_KEY=
# Remitente verificado en Resend (dominio propio). Sin esto usa el sandbox.
EMAIL_FROM=Platita.pe <no-reply@platita.pe>
# Bandeja del equipo que recibe el aviso de cada lead nuevo.
LEAD_NOTIFICATION_EMAIL=leads@platita.pe
# Bandeja que recibe las hojas del Libro de Reclamaciones.
# Si se deja vacío, usa LEAD_NOTIFICATION_EMAIL.
RECLAMOS_NOTIFICATION_EMAIL=reclamos@platita.pe

# El rate limiting es en memoria por instancia (sin dependencias externas).
# Suficiente para tráfico de validación; el honeypot y Turnstile son la
# defensa real contra bots.

# --- Endpoints internos --------------------------------------
# Header `x-internal-secret` para POST /api/verify-phone (marcar teléfono
# verificado a partir del código que el lead manda por WhatsApp).
# Genera uno con:  openssl rand -hex 24
INTERNAL_API_SECRET=

# --- Verificación de contacto (Nivel 1) --------------------
# Teléfono: "true" activa confirmar el teléfono por WhatsApp en la pantalla
#   de éxito. Por defecto off (fricción + excluye a leads del extranjero).
PHONE_VERIFICATION=false
# Correo: por defecto on (botón "confirmar" en el correo de bienvenida).
#   Ponlo en "false" para desactivarlo.
EMAIL_VERIFICATION=true

# --- Google Sheets (espejo de lectura para el equipo) --------
# Cuenta de servicio con acceso de edición al spreadsheet.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Leads
